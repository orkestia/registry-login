#!/usr/bin/env bash
# Docker credential helper for registry.orkestia.dev inside GitHub Actions jobs.
#
# Configure once (an image or a setup step):
#   { "credHelpers": { "registry.orkestia.dev": "orkestia" } }   in ~/.docker/config.json
# Then any docker or buildx command in a job with `permissions: id-token: write`
# gets a fresh registry token. No login step, nothing stored after the job.
#
# Protocol: https://github.com/docker/docker-credential-helpers
#   get    server URL on stdin -> {"ServerURL","Username","Secret"} on stdout
#   store/erase                -> accepted and ignored (tokens are never stored)
#   list                       -> {}
# Optional: ORKESTIA_REGISTRY_SCOPE=pull|push, ORKESTIA_EXCHANGE_URL.
set -euo pipefail

here="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")")" && pwd)"
lib="${ORKESTIA_LIB:-$here/lib.sh}"
[ -f "$lib" ] || lib="/usr/local/lib/orkestia/lib.sh"
# shellcheck source-path=SCRIPTDIR source=lib.sh
. "$lib"

not_found() {
  # The exact text docker treats as "no credentials": it then continues anonymously.
  echo "credentials not found in native keychain"
  exit 1
}

action="${1:-}"
case "$action" in
  store | erase) cat >/dev/null; exit 0 ;;
  list) echo "{}"; exit 0 ;;
  get) ;;
  *) echo "usage: docker-credential-orkestia get|store|erase|list" >&2; exit 2 ;;
esac

server=$(cat | tr -d '[:space:]')
server="${server#https://}"
server="${server#http://}"
server="${server%%/*}"
[ "$server" = "$ORKESTIA_REGISTRY_HOST" ] || not_found
orkestia_need curl jq || not_found

scope="${ORKESTIA_REGISTRY_SCOPE:-}"
case "$scope" in "" | pull | push) ;; *) echo "orkestia: ORKESTIA_REGISTRY_SCOPE must be pull or push" >&2; not_found ;; esac

# docker asks several times per push. Reuse a token for 50 minutes within one job.
cache=""
if [ -n "${RUNNER_TEMP:-}" ] && [ -d "$RUNNER_TEMP" ]; then
  cache="$RUNNER_TEMP/orkestia-registry-login/docker-${scope:-default}.json"
  if [ -f "$cache" ]; then
    now=$(date +%s)
    until=$(jq -r '.until // 0' "$cache" 2>/dev/null || echo 0)
    if [ "$now" -lt "$until" ]; then
      jq -c --arg s "$ORKESTIA_REGISTRY_HOST" '{ServerURL: $s, Username: .namespace, Secret: .token}' "$cache"
      exit 0
    fi
  fi
fi

resp=$(orkestia_exchange "$scope" "${ORKESTIA_EXCHANGE_URL:-}") || not_found
namespace=$(jq -r .namespace <<<"$resp")
token=$(jq -r .access_token <<<"$resp")

if [ -n "$cache" ]; then
  dir=$(dirname "$cache")
  mkdir -p "$dir" && chmod 700 "$dir"
  ( umask 077
    jq -n --arg n "$namespace" --arg t "$token" --argjson u "$(( $(date +%s) + 3000 ))" \
      '{namespace: $n, token: $t, until: $u}' >"$cache" )
fi

jq -n --arg s "$ORKESTIA_REGISTRY_HOST" --arg u "$namespace" --arg t "$token" \
  '{ServerURL: $s, Username: $u, Secret: $t}'
